# Copy the lines you need into .env (never commit .env).
# A service turns on only when its settings are present.

# --- Required ---------------------------------------------------------------
GEMINI_API_KEY=

# --- Context7 (optional: raises the free rate limit) --------------------------
# Free key: https://context7.com
CONTEXT7_API_KEY=

# --- Google Drive: find, read, and save queries/scripts ---------------------
# 1. https://console.cloud.google.com -> new project (a personal Gmail is easiest;
#    school accounts often block this).
# 2. APIs & Services -> enable "Google Drive API" and "Google Drive MCP API".
# 3. OAuth consent screen -> External, add yourself as a test user.
# 4. Credentials -> Create OAuth client ID -> Web application,
#    Authorized redirect URI: http://localhost:8765/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Slack: find and answer teammates' query questions ----------------------
# 1. https://api.slack.com/apps -> Create New App -> From scratch, in your workspace
#    (it must stay an internal app; Slack blocks unlisted apps from MCP).
# 2. OAuth & Permissions -> Redirect URL: http://localhost:8766/callback
# 3. User Token Scopes: search:read.public, search:read.users, channels:read,
#    channels:history, users:read, canvases:read, chat:write
# 4. Basic Information -> copy the Client ID and Client Secret.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Windows control: run scripts/queries to confirm their real output ------
# Every command, file action, and screenshot asks you first.
ENABLE_WINDOWS_MCP=false

# --- Weather: forecasts, air quality, time zones (free Open-Meteo, no key) ---
ENABLE_WEATHER_MCP=false

# --- Radio: focus music from 50,000+ free internet stations (no key) --------
# Plays through Windows' built-in media player; stops when George exits.
ENABLE_RADIO_MCP=false
